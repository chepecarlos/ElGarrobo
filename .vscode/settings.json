{
  "files.exclude": {
    "build": true,
    "dist": true,
    "venv": true,
    "**/__pycache__": true
  },
  "cSpell.words": ["accion", "Accion", "ElGarrobo", "garrobo", "mqtt", "MQTT", "Octoprint", "steamdeck"],
  "editor.formatOnSave": true,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  // "python.analysis.typeCheckingMode": "strict",
  "isort.args": ["--profile", "black"],
  "black-formatter.args": ["--line-length=200"],
  "autopep8.args": ["--max-line-length", "180"],
  "flake8.args": ["--max-line-length=119"],
  "ruff.lint.args": ["--line-length=119"],
  // https://code.visualstudio.com/api/references/theme-color
  "workbench.colorCustomizations": {
    // Color Oscuro
    "activityBar.background": "#003102",
    "tab.inactiveBackground": "#003102",
    "statusBar.background": "#003102",
    "breadcrumb.background": "#003102",
    "editorGroupHeader.tabsBackground": "#003102",
    "titleBar.activeBackground": "#003102",
    "window.activeBorder": "#640000",
    "window.inactiveBorder": "#640000",
    // "activityBar.background": "#640000",
    // Color Claro
    "activityBar.activeBackground": "#082e04",
    "tab.activeBackground": "#0b4c0d",
    // Color Mas Oscuro
    "minimap.background": "#003102",
    "sideBar.background": "#003102"
  },
  "editor.wordWrap": "on",
  // Ordena el codigo para mostarlo en una linea
  "editor.cursorBlinking": "expand",
  // Animacion del Cursos de VScode
  "editor.cursorSmoothCaretAnimation": "on",
  // Animacion de cursos suavidada
  // "flake8.args": [
  //   "--max-line-length=150" // Set to your desired maximum
  // ]
  "python.analysis.typeCheckingMode": "standard" // Configura el modo de verificacion de tipos a estandar
}
